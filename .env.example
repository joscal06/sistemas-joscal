# Copia este archivo como .env.local para desarrollo. En producción se configuran en el panel
# del hosting (Vercel: Settings → Environment Variables; Amplify: Hosting → Environment variables).
# Nunca subas el .env real.
#
# Nota: Amplify no permite nombres que empiecen con "AWS", por eso las claves de acceso
# usan el prefijo DB_.

# --- Base de datos: Upstash Redis (Vercel) ---------------------------------------------
# Vercel las crea solas al conectar "Upstash for Redis" desde Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Base de datos alternativa (Amazon DynamoDB) -------------------------------------------------
# Nombre de la tabla. Clave de partición "pk" (String) y clave de ordenamiento "sk" (String).
DB_TABLE=
# Región de la tabla
DB_REGION=us-east-1
# Claves de un usuario IAM con permisos solo sobre esa tabla (ver README).
# Déjalas vacías si la app usa un rol de cómputo de Amplify.
DB_ACCESS_KEY_ID=
DB_SECRET_ACCESS_KEY=
# "memory" fuerza datos de ejemplo en memoria; "redis" ignora DB_TABLE.
# Vacío = DynamoDB si hay DB_TABLE, si no Redis si hay credenciales KV_*, si no memoria.
DATA_STORE=

# --- Acceso al panel /admin ----------------------------------------------------------
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contraseña
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Sitio ---------------------------------------------------------------------------
# URL pública del despliegue (metadatos Open Graph). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://sistemas-joscal.vercel.app
